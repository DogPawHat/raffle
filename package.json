{
  "name": "raffle",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "ready": "vp check && vp run -r test && vp run -r build",
    "dev": "vp run @raffle/react#build && vp run start-basic#dev",
    "dev:query": "vp run start-query#dev",
    "dev:raf-query": "vp run start-raf-query#dev",
    "dev:tracker-raffle": "vp run @raffle/react#build && vp run tracker-raffle#dev",
    "dev:tracker-query": "vp run tracker-query#dev",
    "dev:tracker-raf-query": "vp run tracker-raf-query#dev",
    "prepare": "vp config"
  },
  "devDependencies": {
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.15.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
